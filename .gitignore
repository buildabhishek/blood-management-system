#######################################
# 🔐 Environment & Secrets
#######################################
# Root env files
.env
.env.*
*.local

# React env files
frontend/.env*
blood-bank-ui/.env*

# Spring Boot secrets
backend/src/main/resources/application.properties
backend/src/main/resources/application-*.properties

# Firebase / credentials
backend/firebase-service-account.json

#######################################
# ☕ Java / Spring Boot (Maven)
#######################################
# Build output
target/
!**/src/main/**/target/
!**/src/test/**/target/

# Compiled files
*.class

# Packaged artifacts
*.jar
*.war
*.ear

# Maven Wrapper (keep jar tracked if you want reproducibility)
# Remove below line if you WANT to track wrapper jar
.mvn/wrapper/maven-wrapper.jar

